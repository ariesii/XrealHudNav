<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 標題與簡介 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XREAL Air 2 Pro 導航 HUD"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Micro-OLED 極簡透明抬頭顯示系統"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />

        <!-- 狀態卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 眼鏡連接狀態 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/indicatorGlasses"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_hud_badge"
                        android:backgroundTint="#FF5252" />

                    <TextView
                        android:id="@+id/tvGlassesStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/glasses_disconnected"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#2C2C2C" />

                <!-- 通知監聽授權狀態 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPermissionStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/permission_required"
                        android:textColor="#FFB300"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnGrantPermission"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="前往設定"
                        android:textColor="@color/hud_accent_cyan" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 眼鏡端 HUD 鏡像預覽視窗 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hud_preview_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 模擬 16:9 Micro-OLED 純黑視界 -->
        <FrameLayout
            android:id="@+id/previewWindow"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="8dp"
            android:background="#000000">

            <include
                android:id="@+id/hudPreviewContent"
                layout="@layout/presentation_xreal_hud" />

            <!-- 預覽輔助標籤 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:text="1080p OLED 預覽"
                android:textColor="#44FFFFFF"
                android:textSize="11sp" />
        </FrameLayout>

        <!-- HUD 位置與視角微調控制項 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="視野微調（適配個人瞳距與配戴高度）"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 垂直位移 (Y) -->
                <TextView
                    android:id="@+id/tvOffsetYLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="垂直高度微調 (Y Offset): 0 px"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderOffsetY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="0"
                    android:valueFrom="-150"
                    android:valueTo="150"
                    android:stepSize="10" />

                <!-- 水平位移 (X) -->
                <TextView
                    android:id="@+id/tvOffsetXLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="水平位置微調 (X Offset): 0 px"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderOffsetX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="0"
                    android:valueFrom="-200"
                    android:valueTo="200"
                    android:stepSize="10" />

                <!-- 縮放大小 -->
                <TextView
                    android:id="@+id/tvScaleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="縮放比例 (Scale): 1.0x"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderScale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="1.0"
                    android:valueFrom="0.7"
                    android:valueTo="1.3"
                    android:stepSize="0.05" />

                <Button
                    android:id="@+id/btnResetOffset"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="重設位置"
                    android:textColor="@color/hud_accent_cyan" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 導航模擬測試控制項 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="離線測試與路況情境模擬"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="模擬「106 民族路」路口左轉與抵達情境，無需實際出門導航。"
                    android:textColor="#90A4AE"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnToggleDemo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/hud_accent_cyan"
                    android:text="@string/start_demo"
                    android:textColor="#000000" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
