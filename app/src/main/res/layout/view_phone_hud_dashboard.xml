<?xml version="1.0" encoding="utf-8"?>
<!-- 
    手機端直立專用 HUD 導航儀表板 (Portrait Phone HUD Dashboard)
    專為手機直螢幕設計，徹底解決 1080p 橫向 HUD 在直立手機上左右文字打架、重疊遮蔽的問題！
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/phoneHudRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0D12"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 第一層：頂部系統狀態與地圖來源列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/phoneTvMapSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_badge"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="[HUD 就緒] 待機中"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phoneTvPowerMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="標準模式"
            android:textColor="#90A4AE"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/phoneTvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔋 85%"
            android:textColor="#69F0AE"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 第二層：核心轉向箭頭與距離動作區 (左右並列，寬敞不重疊) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 轉向箭頭圖標 (支援 Google Maps / 高德原創 Bitmap) -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_hud_badge"
            android:padding="8dp">

            <ImageView
                android:id="@+id/phoneIvManeuver"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_straight" />
        </FrameLayout>

        <!-- 距離與動作說明 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 超大距離數字 (如 48公尺 或 --) -->
            <TextView
                android:id="@+id/phoneTvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="#FFD54F"
                android:textSize="38sp"
                android:textStyle="bold" />

            <!-- 下一步動作提示 -->
            <TextView
                android:id="@+id/phoneTvNextAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="等待導航指令"
                android:textColor="#00E5FF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第三層：當前/目標道路名稱橫幅 (大字清晰呈現) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#141A23"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/phoneTvRoadNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_hud_badge"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="#FFD54F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="台1線" />

        <TextView
            android:id="@+id/phoneTvRoadName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="等待導航開始..."
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 第四層：即時 GPS 車速與測速相機警示列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 左側：震撼 GPS 車速 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/phoneTvSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="#69F0AE"
                android:textSize="50sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/phoneTvSpeedUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp"
                android:text="km/h"
                android:textColor="#90A4AE"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 右側：測速照相提醒 Chip -->
        <LinearLayout
            android:id="@+id/phoneLayoutCameraAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/phoneTvCameraTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 50"
                android:textColor="#FFB300"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/phoneTvCameraDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="280m"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第五層：車道線導引與紅綠燈號誌倒數列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 車道線容器 -->
        <LinearLayout
            android:id="@+id/phoneLayoutLanes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 紅綠燈秒數膠囊 -->
        <LinearLayout
            android:id="@+id/phoneLayoutTrafficLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:id="@+id/phoneViewTrafficLightDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_hud_badge"
                android:backgroundTint="#FF3B30" />

            <TextView
                android:id="@+id/phoneTvTrafficLightSeconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="24s"
                android:textColor="#FF3B30"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/phoneTvTrafficLightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="紅燈等待"
                android:textColor="#90A4AE"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部行程摘要列 (預計抵達時間 · 剩餘公里) -->
    <TextView
        android:id="@+id/phoneTvTripSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="-- · --"
        android:textColor="#546E7A"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
