name: 線上自動編譯 Android APK

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch: # 支援在 GitHub 網頁上隨時手動點擊按鈕編譯

jobs:
  build:
    name: 編譯 XREAL 導航 HUD APK
    runs-on: ubuntu-latest

    steps:
      - name: 簽出原始碼 (Checkout)
        uses: actions/checkout@v4

      - name: 設定 JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: 設定 Android SDK
        uses: actions/setup-android@v3

      - name: 自動產生 Gradle Wrapper 執行檔
        run: |
          gradle wrapper --gradle-version 8.4
          chmod +x ./gradlew

      - name: 線上編譯 Debug APK
        run: ./gradlew assembleDebug --stacktrace

      - name: 上傳編譯完成的 APK 供下載
        uses: actions/upload-artifact@v4
        with:
          name: XrealHudNav-debug-apk
          path: app/build/outputs/apk/debug/*.apk
