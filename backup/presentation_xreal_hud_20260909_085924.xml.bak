<?xml version="1.0" encoding="utf-8"?>
<!-- 
    XREAL Air 2 Pro 專用 HUD 佈局 (1920x1080)
    巨幅升級：
    1. 指標區放大 2 倍 (136dp 箭頭、56sp 距離、50sp 路名)
    2. GPS 時速字型放大 3 倍 (96sp 超大震撼數字)
    3. 即時電池電量圖標 (🔋 85%) 與多檔省電模式指示
    4. 智慧紅綠燈秒數倒數膠囊 (🔴 24s / 🟢 15s)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_background">

    <!-- 頂部正中央微光系統狀態列：電池電量圖標 + 省電模型標籤 -->
    <LinearLayout
        android:id="@+id/layoutSystemStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hud_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="3dp"
        android:paddingEnd="12dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/tvBatteryIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔋"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvBatteryLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/hud_accent_cyan"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="85%" />

        <View
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#44FFFFFF" />

        <TextView
            android:id="@+id/tvPowerModeTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hud_text_secondary"
            android:textSize="12sp"
            tools:text="標準模式" />
    </LinearLayout>

    <!-- 右上角巨型資訊區：96sp 超大字體車速 + 測速照相提醒 + 紅綠燈秒數膠囊 -->
    <LinearLayout
        android:id="@+id/layoutSpeedometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- 震撼超大 96sp GPS 車速數值（原版 32sp 放大 3 倍） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:shadowColor="#EE000000"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="6"
                android:textColor="@color/hud_accent_cyan"
                android:textSize="96sp"
                android:textStyle="bold"
                tools:text="48" />

            <TextView
                android:id="@+id/tvSpeedUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:shadowColor="#EE000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="km/h"
                android:textColor="@color/hud_text_secondary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 智慧紅綠燈秒數倒數膠囊 (如 🔴 24s / 🟢 15s) -->
        <LinearLayout
            android:id="@+id/layoutTrafficLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_hud_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:id="@+id/viewTrafficLightDot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_hud_badge"
                android:backgroundTint="#FF3B30" />

            <TextView
                android:id="@+id/tvTrafficLightSeconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF3B30"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="24s" />

            <TextView
                android:id="@+id/tvTrafficLightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/hud_text_secondary"
                android:textSize="14sp"
                tools:text="紅燈等待" />
        </LinearLayout>

        <!-- 測速照相機警示 Chip (如 [📷 50] 280m) -->
        <LinearLayout
            android:id="@+id/layoutCameraAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_hud_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvCameraTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hud_accent_amber"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="📷 50" />

            <TextView
                android:id="@+id/tvCameraDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/hud_text_primary"
                android:textSize="16sp"
                tools:text="280m" />
        </LinearLayout>

        <!-- 地圖來源標籤 -->
        <TextView
            android:id="@+id/tvMapSourceTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#44FFFFFF"
            android:textSize="12sp"
            tools:text="高德地圖" />
    </LinearLayout>

    <!-- 主 HUD 導航指標區 (放大 2 倍：136dp 箭頭、56sp 距離、50sp 路名) -->
    <LinearLayout
        android:id="@+id/hudContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 2 倍巨型向量轉向箭頭 (136dp x 136dp) -->
            <ImageView
                android:id="@+id/ivManeuver"
                android:layout_width="136dp"
                android:layout_height="136dp"
                android:contentDescription="轉向指示"
                android:src="@drawable/ic_arrow_turn_right" />

            <!-- 距離與道路標示 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <!-- 2 倍放大距離高亮標示 (56sp) -->
                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:shadowColor="#EE000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:textColor="@color/hud_accent_cyan"
                    android:textSize="56sp"
                    android:textStyle="bold"
                    tools:text="48m" />

                <!-- 2 倍放大道路標示 (50sp) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 道路編號框 -->
                    <TextView
                        android:id="@+id/tvRoadNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_hud_badge"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="106" />

                    <!-- 主要道路名稱 (50sp) -->
                    <TextView
                        android:id="@+id/tvRoadName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:shadowColor="#EE000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="50sp"
                        android:textStyle="bold"
                        tools:text="民族路" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 3dp 微光距離倒數進度條 -->
        <FrameLayout
            android:id="@+id/layoutProgressTrack"
            android:layout_width="340dp"
            android:layout_height="4dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="156dp"
            android:background="#1AFFFFFF">

            <View
                android:id="@+id/viewProgressBar"
                android:layout_width="340dp"
                android:layout_height="match_parent"
                android:background="@color/hud_accent_cyan" />
        </FrameLayout>

        <!-- 次要提示與接下來動作 (20sp) -->
        <LinearLayout
            android:id="@+id/layoutNextAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="156dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNextAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hud_accent_amber"
                android:textSize="20sp"
                tools:text="請注意觀察周邊環境，謹慎駕駛" />
        </LinearLayout>

        <!-- 行程進度列 (16sp) -->
        <LinearLayout
            android:id="@+id/layoutTripSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="156dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTripSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hud_text_secondary"
                android:textSize="16sp"
                tools:text="28 分鐘 · 10.6 公里 · 下午 3:19" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvStandbyHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#33FFFFFF"
        android:textSize="15sp"
        android:text="XREAL Air HUD 已就緒 · 等待導航啟動" />

</FrameLayout>
