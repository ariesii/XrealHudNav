<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 系統保活與通知權限 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 系統懸浮窗權限（用於壓制鎖屏時鐘，將 Presentation 視窗提升至最高層級） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- GPS 與網路高精度定位權限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 套件可見性宣告：允許讀取高德地圖與 Google 地圖的資源與通知 (Android 11+) -->
    <queries>
        <package android:name="com.autonavi.minimap" />
        <package android:name="com.autonavi.amapauto" />
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_destination"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XrealHudNav"
        tools:targetApi="31">

        <!-- 手機端主控制介面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google Maps 與高德地圖導航通知監聽服務 -->
        <service
            android:name=".service.MapsNotificationListenerService"
            android:exported="true"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 高德地圖車載標準導航廣播接收器 -->
        <receiver
            android:name=".receiver.AmapBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="AUTONAVI_STANDARD_BROADCAST_SEND" />
                <action android:name="com.autonavi.minimap.action.NAVIGATION_INFO" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
