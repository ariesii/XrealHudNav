<?xml version="1.0" encoding="utf-8"?>
<!-- 
    XREAL Air 2 Pro 專用 HUD 佈局 (1920x1080)
    升級亮點：
    1. 全屏純黑背景 (#000000) 物理全透明
    2. Smart Glance 智能平滑淡出與喚醒
    3. 右上角極簡 GPS 時速表與測速相機警告
    4. 轉向流光箭頭與 2dp 微光距離倒數條
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_background">

    <!-- 右上角極簡資訊區：GPS 時速表 + 測速照相機警示標籤 -->
    <LinearLayout
        android:id="@+id/layoutSpeedometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="36dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- 時速數值與單位 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hud_accent_cyan"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="48" />

            <TextView
                android:id="@+id/tvSpeedUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:text="km/h"
                android:textColor="@color/hud_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 測速照相機警示 Chip (如 [📷 50] 280m) -->
        <LinearLayout
            android:id="@+id/layoutCameraAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_hud_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvCameraTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hud_accent_amber"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="📷 50" />

            <TextView
                android:id="@+id/tvCameraDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/hud_text_primary"
                android:textSize="13sp"
                tools:text="280m" />
        </LinearLayout>

        <!-- 地圖來源小標籤 (Google / 高德) -->
        <TextView
            android:id="@+id/tvMapSourceTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#33FFFFFF"
            android:textSize="10sp"
            tools:text="Google Maps" />
    </LinearLayout>

    <!-- 主 HUD 導航指引區 (位於上方中央，支援微調位移與 Smart Glance 淡入淡出) -->
    <LinearLayout
        android:id="@+id/hudContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 轉向箭頭與主要道路標示 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 向量轉向箭頭 (支援轉彎動態流光呼吸動畫) -->
            <ImageView
                android:id="@+id/ivManeuver"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="轉向指示"
                android:src="@drawable/ic_arrow_straight" />

            <!-- 距離與道路標示 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <!-- 距離高亮標示 -->
                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hud_accent_cyan"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="150 公尺" />

                <!-- 道路標示列（編號標籤 + 道路名稱） -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 道路編號框 (如 [106]) -->
                    <TextView
                        android:id="@+id/tvRoadNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_hud_badge"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:visibility="visible"
                        tools:text="106" />

                    <!-- 主要道路名稱 -->
                    <TextView
                        android:id="@+id/tvRoadName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="#80000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="民族路" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 2dp 極細微光距離倒數線 (逼近路口時動態平滑縮減) -->
        <FrameLayout
            android:id="@+id/layoutProgressTrack"
            android:layout_width="260dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="80dp"
            android:background="#1AFFFFFF">

            <View
                android:id="@+id/viewProgressBar"
                android:layout_width="260dp"
                android:layout_height="match_parent"
                android:background="@color/hud_accent_cyan" />
        </FrameLayout>

        <!-- 次要提示與接下來動作 (如 "接下來 ↰ 106縣道") -->
        <LinearLayout
            android:id="@+id/layoutNextAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="80dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNextAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hud_accent_amber"
                android:textSize="17sp"
                tools:text="接下來 ↰ 106縣道" />
        </LinearLayout>

        <!-- 輔助資訊列：剩餘時間 / 總里程 / ETA -->
        <LinearLayout
            android:id="@+id/layoutTripSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="80dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTripSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hud_text_secondary"
                android:textSize="14sp"
                tools:text="23 分鐘 · 11 公里 · 上午 10:12" />
        </LinearLayout>

    </LinearLayout>

    <!-- 待機微光提示 -->
    <TextView
        android:id="@+id/tvStandbyHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#33FFFFFF"
        android:textSize="14sp"
        android:text="XREAL Air HUD 已就緒 · 等待導航啟動" />

</FrameLayout>
