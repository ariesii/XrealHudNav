package com.xreal.hudnav.service

import android.app.Notification
import android.content.BroadcastReceiver
import android.content.Context
import android.content.Intent
import android.content.IntentFilter
import android.graphics.Bitmap
import android.graphics.drawable.BitmapDrawable
import android.os.Build
import android.service.notification.NotificationListenerService
import android.service.notification.StatusBarNotification
import android.util.Log
import com.xreal.hudnav.model.ManeuverType
import com.xreal.hudnav.model.NavInfo
import com.xreal.hudnav.model.NavStateRepository
import com.xreal.hudnav.model.TrafficLightState
import java.util.regex.Pattern

/**
 * 雙地圖即時導航通知監聽服務
 * 整合 Google Maps 通知、高德地圖通知、高德車載標準廣播與 LargeIcon 視覺分析
 */
class MapsNotificationListenerService : NotificationListenerService() {

    companion object {
        private const val TAG = "MultiMapNotification"
        private const val PKG_GOOGLE_MAPS = "com.google.android.apps.maps"
        private const val PKG_AMAP_STANDARD = "com.autonavi.minimap"
        private const val PKG_AMAP_AUTO = "com.autonavi.amapauto"

        // 高德車載標準導航廣播 Action
        private const val ACTION_AMAP_BROADCAST = "AUTONAVI_STANDARD_BROADCAST_SEND"

        private val DISTANCE_PATTERN = Pattern.compile("(\\d+(\\.\\d+)?\\s*(公尺|公里|米|m|km))", Pattern.CASE_INSENSITIVE)
        private val ROAD_NUM_PATTERN = Pattern.compile("(\\b[A-Za-z]?\\d{1,4}\\b|台\\d+|國道\\d+|市道\\d+|省道\\d+)")
        
        // 紅綠燈即時秒數正則 (如 "紅燈 24秒"、"綠燈等待 15s")
        private val TRAFFIC_LIGHT_PATTERN = Pattern.compile("(紅燈|綠燈|黃燈|等待)\\D*?(\\d{1,3})\\s*(秒|s)?", Pattern.CASE_INSENSITIVE)
    }

    private var amapReceiver: BroadcastReceiver? = null

    override fun onCreate() {
        super.onCreate()
        registerAmapBroadcastReceiver()
    }

    override fun onDestroy() {
        super.onDestroy()
        unregisterAmapBroadcastReceiver()
    }

    /**
     * 註冊高德地圖標準導航廣播監聽器
     */
    private fun registerAmapBroadcastReceiver() {
        amapReceiver = object : BroadcastReceiver() {
            override fun onReceive(context: Context?, intent: Intent?) {
                if (intent?.action == ACTION_AMAP_BROADCAST) {
                    val keyType = intent.getIntExtra("KEY_TYPE", 0)
                    NavStateRepository.appendNotificationLog("廣播[高德] KEY_TYPE=$keyType")
                    if (keyType == 10001) { // 導航資訊更新
                        val iconCode = intent.getIntExtra("EXTRA_MNAEUVER_ID", intent.getIntExtra("EXTRA_ICON", 0))
                        val nextRoad = intent.getStringExtra("EXTRA_NEXT_ROAD_NAME").orEmpty()
                        val remainDis = intent.getIntExtra("EXTRA_SEG_REMAIN_DIS", 0)

                        Log.i(TAG, "收到高德車載廣播 -> 動作代碼: $iconCode, 下一路口: $nextRoad, 剩餘公尺: $remainDis")
                        NavStateRepository.appendNotificationLog("高德廣播路況: $nextRoad, $remainDis m, code=$iconCode")

                        if (iconCode > 0 || nextRoad.isNotBlank()) {
                            val maneuver = ManeuverType.fromAmapIconCode(iconCode)
                            val current = NavStateRepository.navState.value
                            val generatedLanes = buildLanesForManeuver(maneuver)
                            val trafficBars = listOf(
                                com.xreal.hudnav.model.TrafficSegment("#34C759", 0.6f),
                                com.xreal.hudnav.model.TrafficSegment("#FFCC00", 0.25f),
                                com.xreal.hudnav.model.TrafficSegment("#FF3B30", 0.15f)
                            )
                            NavStateRepository.updateNavInfo(
                                current.copy(
                                    maneuver = maneuver,
                                    distance = if (remainDis > 0) "${remainDis}m" else current.distance,
                                    distanceMeters = if (remainDis > 0) remainDis else current.distanceMeters,
                                    roadName = if (nextRoad.isNotBlank()) nextRoad else current.roadName,
                                    lanes = generatedLanes,
                                    trafficSegments = trafficBars,
                                    mapSource = "高德地圖",
                                    isNavigating = true
                                )
                            )
                        }
                    }
                }
            }
        }
        val filter = IntentFilter(ACTION_AMAP_BROADCAST)
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            registerReceiver(amapReceiver, filter, Context.RECEIVER_EXPORTED)
        } else {
            registerReceiver(amapReceiver, filter)
        }
    }

    private fun unregisterAmapBroadcastReceiver() {
        amapReceiver?.let {
            try { unregisterReceiver(it) } catch (_: Exception) {}
            amapReceiver = null
        }
    }

    private fun isTargetMapPackage(pkg: String): Boolean {
        val lower = pkg.lowercase()
        return lower.contains("autonavi") ||
                lower.contains("amap") ||
                lower.contains("google.android.apps.maps") ||
                lower.contains("waze") ||
                (lower.contains("map") && !lower.contains("wallpaper") && !lower.contains("camera"))
    }

    override fun onNotificationPosted(sbn: StatusBarNotification?) {
        super.onNotificationPosted(sbn)
        if (sbn == null) return

        val pkg = sbn.packageName
        if (!isTargetMapPackage(pkg)) return

        val notification = sbn.notification ?: return
        val extras = notification.extras ?: return

        val mapSourceName = when {
            pkg.contains("google", ignoreCase = true) -> "Google Maps"
            pkg.contains("autonavi", ignoreCase = true) || pkg.contains("amap", ignoreCase = true) -> "高德地圖"
            pkg.contains("waze", ignoreCase = true) -> "Waze"
            else -> "導航"
        }

        val title = extras.getCharSequence(Notification.EXTRA_TITLE)?.toString().orEmpty()
        val text = extras.getCharSequence(Notification.EXTRA_TEXT)?.toString().orEmpty()
        val subText = extras.getCharSequence(Notification.EXTRA_SUB_TEXT)?.toString().orEmpty()
        val ticker = notification.tickerText?.toString().orEmpty()

        // 深度提取：掃描 RemoteViews (contentView, bigContentView, headsUpContentView) 與 Extras 所有字串
        val remoteViewData = extractRemoteViewsData(notification, sbn.packageName)
        val allExtractedTexts = mutableListOf<String>()

        // 收集 Extras 內部所有文字
        for (key in extras.keySet()) {
            val v = extras.get(key)
            if (v is CharSequence && v.isNotBlank()) {
                allExtractedTexts.add(v.toString().trim())
            } else if (v is Array<*> && v.isArrayOf<CharSequence>()) {
                for (item in v) {
                    if (item is CharSequence && item.isNotBlank()) allExtractedTexts.add(item.toString().trim())
                }
            }
        }

        allExtractedTexts.addAll(remoteViewData.texts)
        val distinctTexts = allExtractedTexts.distinct().filter { 
            it.isNotBlank() && it != "高德地圖" && it != "正在導航" && it != "導航中"
        }

        // 若為高德地圖，主動發送車載標準廣播握手請求，雙管齊下獲取原生結構化數據
        if (sbn.packageName.contains("autonavi")) {
            com.xreal.hudnav.receiver.AmapBroadcastReceiver.requestAmapBroadcast(this)
        }

        val logEntry = if (distinctTexts.isNotEmpty()) {
            "[$mapSourceName] 抓取: " + distinctTexts.joinToString(" | ")
        } else {
            val keysDump = extras.keySet().joinToString(",")
            "[$mapSourceName] $title | $text (無內文, extras鍵: $keysDump)"
        }
        Log.d(TAG, logEntry)
        NavStateRepository.appendNotificationLog(logEntry)

        parseAndPostNavData(mapSourceName, title, text, subText, ticker, distinctTexts, remoteViewData.firstBitmap, notification)
    }

    override fun onNotificationRemoved(sbn: StatusBarNotification?) {
        super.onNotificationRemoved(sbn)
        val pkg = sbn?.packageName.orEmpty()
        if (isTargetMapPackage(pkg)) {
            NavStateRepository.appendNotificationLog("通知移除: $pkg")
            NavStateRepository.updateNavInfo(
                NavStateRepository.navState.value.copy(
                    isNavigating = false,
                    roadName = "導航已結束"
                )
            )
        }
    }

    data class RemoteViewExtractResult(
        val texts: List<String>,
        val firstBitmap: Bitmap?
    )

    private fun extractRemoteViewsData(notification: Notification, targetPackage: String): RemoteViewExtractResult {
        val texts = mutableListOf<String>()
        var foundBitmap: Bitmap? = null

        val rvs = listOfNotNull(
            notification.bigContentView,
            notification.contentView,
            notification.headsUpContentView
        )

        // 關鍵：使用目標套件 Context 載入資源，避免跨進程 ResourceNotFoundException
        val packageCtx = try {
            createPackageContext(targetPackage, Context.CONTEXT_RESTRICTED or Context.CONTEXT_IGNORE_SECURITY)
        } catch (_: Exception) {
            applicationContext
        }

        for (rv in rvs) {
            try {
                val dummyParent = android.widget.FrameLayout(packageCtx)
                val inflated = rv.apply(packageCtx, dummyParent)
                extractViewsRecursive(inflated, texts) { bmp ->
                    if (foundBitmap == null) foundBitmap = bmp
                }
            } catch (e: Exception) {
                // 若 apply 失敗，降級為反射讀取 Action
                extractViaReflection(rv, texts)
            }
        }

        return RemoteViewExtractResult(texts.distinct(), foundBitmap)
    }

    private fun extractViewsRecursive(view: android.view.View, texts: MutableList<String>, onBitmapFound: (Bitmap) -> Unit) {
        if (view is android.widget.TextView) {
            val str = view.text?.toString()?.trim()
            if (!str.isNullOrBlank()) {
                texts.add(str)
            }
        } else if (view is android.widget.ImageView) {
            val d = view.drawable
            if (d is BitmapDrawable && d.bitmap != null) {
                onBitmapFound(d.bitmap)
            }
        } else if (view is android.view.ViewGroup) {
            for (i in 0 until view.childCount) {
                extractViewsRecursive(view.getChildAt(i), texts, onBitmapFound)
            }
        }
    }

    private fun extractViaReflection(rv: android.widget.RemoteViews, texts: MutableList<String>) {
        try {
            val field = rv.javaClass.getDeclaredField("mActions")
            field.isAccessible = true
            val actions = field.get(rv) as? java.util.ArrayList<*> ?: return
            for (action in actions) {
                if (action == null) continue
                for (f in action.javaClass.declaredFields) {
                    f.isAccessible = true
                    val v = f.get(action)
                    if (v is CharSequence && v.isNotBlank()) {
                        texts.add(v.toString().trim())
                    }
                }
            }
        } catch (_: Exception) {}
    }

    private fun parseAndPostNavData(
        source: String,
        title: String,
        text: String,
        subText: String,
        ticker: String,
        extractedTexts: List<String>,
        rvBitmap: Bitmap?,
        notification: Notification
    ) {
        val fullContentBuilder = StringBuilder()
        fullContentBuilder.append(title).append(" ").append(subText).append(" ").append(text).append(" ").append(ticker)
        for (str in extractedTexts) {
            fullContentBuilder.append(" ").append(str)
        }
        val fullContent = fullContentBuilder.toString()

        // 1. 推斷轉向動作（結合文字分析與圖標特徵分析）
        var maneuver = ManeuverType.fromText(fullContent)

        // 優先從提取的短句逐一判定轉向，避免長字串干擾
        for (item in extractedTexts) {
            val m = ManeuverType.fromText(item)
            if (m != ManeuverType.UNKNOWN && m != ManeuverType.STRAIGHT) {
                maneuver = m
                break
            }
        }

        // 如果仍為未知或直行，嘗試透過 RemoteViews 或 Notification 的 Bitmap 做重心判定
        if (maneuver == ManeuverType.STRAIGHT || maneuver == ManeuverType.UNKNOWN) {
            val targetBmp = rvBitmap ?: extractBitmapFromNotification(notification)
            if (targetBmp != null) {
                val iconManeuver = analyzeBitmapDirection(targetBmp)
                if (iconManeuver != null) {
                    maneuver = iconManeuver
                    Log.i(TAG, "透過圖標視覺重心成功識別轉向: ${maneuver.description}")
                }
            }
        }

        // 2. 擷取距離字串與公尺 (優先從 extractedTexts 找，如「48米」、「150m」)
        var distanceStr = ""
        var distanceMeters = 1000

        for (item in extractedTexts) {
            val matcher = DISTANCE_PATTERN.matcher(item)
            if (matcher.find()) {
                distanceStr = matcher.group(1).orEmpty()
                distanceMeters = parseDistanceToMeters(distanceStr)
                break
            }
        }

        if (distanceStr.isBlank()) {
            val distMatcher = DISTANCE_PATTERN.matcher(fullContent)
            if (distMatcher.find()) {
                distanceStr = distMatcher.group(1).orEmpty()
                distanceMeters = parseDistanceToMeters(distanceStr)
            }
        }

        // 3. 擷取道路編號與名稱
        var roadNum: String? = null
        val numMatcher = ROAD_NUM_PATTERN.matcher(fullContent)
        if (numMatcher.find()) {
            roadNum = numMatcher.group(1)
        }

        // 從提取的文字中挑選最像路名的字串（長度 2~12，包含「路」、「街」、「道」、「橋」、「巷」或進入/前往之後的詞）
        var cleanRoadName = ""
        for (item in extractedTexts) {
            val candidate = item
                .replace("前往", "")
                .replace("進入", "")
                .replace("直行", "")
                .replace("左轉", "")
                .replace("右轉", "")
                .replace("沿", "")
                .replace("行駛", "")
                .replace(distanceStr, "")
                .trim()
            if (candidate.isNotBlank() && candidate.length in 2..15) {
                if (candidate.contains("路") || candidate.contains("街") || candidate.contains("道") || 
                    candidate.contains("橋") || candidate.contains("高架") || candidate.contains("大道")) {
                    cleanRoadName = candidate
                    break
                }
            }
        }

        if (cleanRoadName.isBlank()) {
            for (item in extractedTexts) {
                val candidate = item.replace(distanceStr, "").trim()
                if (candidate.isNotBlank() && candidate.length in 2..12 && !candidate.contains("分鐘") && !candidate.contains("公里")) {
                    cleanRoadName = candidate
                    break
                }
            }
        }

        if (cleanRoadName.isBlank()) {
            cleanRoadName = if (roadNum != null) "$roadNum 道路" else "導航行駛中"
        }

        // 4. 解析次要提示（如警示、接下來動作）
        var nextAction: String? = null
        for (item in extractedTexts) {
            if (item.contains("謹慎") || item.contains("注意") || item.contains("前方") || item.contains("經過")) {
                nextAction = item
                break
            }
        }

        // 5. 解析紅綠燈秒數資訊
        var trafficLightState = TrafficLightState.NONE
        var trafficLightSeconds: Int? = null
        val tlMatcher = TRAFFIC_LIGHT_PATTERN.matcher(fullContent)
        if (tlMatcher.find()) {
            val stateStr = tlMatcher.group(1).orEmpty()
            val secStr = tlMatcher.group(2).orEmpty()
            val secs = secStr.toIntOrNull()
            if (secs != null && secs > 0) {
                trafficLightSeconds = secs
                trafficLightState = when {
                    stateStr.contains("紅") || stateStr.contains("等待") -> TrafficLightState.RED
                    stateStr.contains("綠") -> TrafficLightState.GREEN
                    stateStr.contains("黃") -> TrafficLightState.YELLOW
                    else -> TrafficLightState.RED
                }
            }
        }

        // 6. 解析剩餘行程資訊 (如 28分鐘 · 10.6公里)
        var remainingTime = "--"
        var remainingDistance = "--"
        var eta = "--:--"
        for (item in extractedTexts) {
            if (item.contains("分") || item.contains("時") || item.contains("小時")) {
                remainingTime = item
            } else if (item.contains("公里") || item.contains("km")) {
                remainingDistance = item
            }
        }
        if (text.isNotBlank() && (remainingTime == "--" || remainingDistance == "--")) {
            val parts = text.split("·", "-", "•", ",").map { it.trim() }
            if (parts.isNotEmpty()) remainingTime = parts[0]
            if (parts.size > 1) remainingDistance = parts[1]
            if (parts.size > 2) eta = parts[2]
        }

        val currentRepo = NavStateRepository.navState.value
        val generatedLanes = buildLanesForManeuver(maneuver)
        val trafficBars = listOf(
            com.xreal.hudnav.model.TrafficSegment("#34C759", 0.6f),
            com.xreal.hudnav.model.TrafficSegment("#FFCC00", 0.25f),
            com.xreal.hudnav.model.TrafficSegment("#FF3B30", 0.15f)
        )

        val navInfo = NavInfo(
            maneuver = maneuver,
            distance = if (distanceStr.isNotBlank()) distanceStr else "直行",
            distanceMeters = distanceMeters,
            roadNumber = roadNum,
            roadName = cleanRoadName,
            nextAction = nextAction ?: if (subText.isNotBlank()) subText else null,
            eta = eta,
            remainingTime = remainingTime,
            remainingDistance = remainingDistance,
            currentSpeed = currentRepo.currentSpeed,
            speedLimit = currentRepo.speedLimit,
            cameraWarning = currentRepo.cameraWarning,
            cameraDistance = currentRepo.cameraDistance,
            trafficLightState = trafficLightState,
            trafficLightSeconds = trafficLightSeconds,
            mapSource = source,
            isNavigating = true,
            lanes = generatedLanes,
            trafficSegments = trafficBars,
            routeProgress = 0.35f
        )

        NavStateRepository.updateNavInfo(navInfo)
    }

    private fun extractBitmapFromNotification(notification: Notification): Bitmap? {
        return try {
            val icon = notification.getLargeIcon() ?: return null
            val drawable = icon.loadDrawable(this) ?: return null
            if (drawable is BitmapDrawable) {
                drawable.bitmap
            } else {
                val bmp = Bitmap.createBitmap(32, 32, Bitmap.Config.ARGB_8888)
                val canvas = android.graphics.Canvas(bmp)
                drawable.setBounds(0, 0, 32, 32)
                drawable.draw(canvas)
                bmp
            }
        } catch (_: Exception) {
            null
        }
    }

    private fun analyzeBitmapDirection(bitmap: Bitmap): ManeuverType? {
        return try {
            val width = bitmap.width
            val height = bitmap.height
            var leftLum = 0L
            var rightLum = 0L

            for (y in 0 until height) {
                for (x in 0 until width) {
                    val pixel = bitmap.getPixel(x, y)
                    val alpha = (pixel shr 24) and 0xFF
                    val red = (pixel shr 16) and 0xFF
                    val green = (pixel shr 8) and 0xFF
                    val blue = pixel and 0xFF
                    val lum = (red + green + blue) * alpha / 255

                    if (x < width / 2) {
                        leftLum += lum
                    } else if (x > width / 2) {
                        rightLum += lum
                    }
                }
            }

            when {
                rightLum > leftLum * 1.35 -> ManeuverType.TURN_RIGHT
                leftLum > rightLum * 1.35 -> ManeuverType.TURN_LEFT
                else -> null
            }
        } catch (_: Exception) {
            null
        }
    }

    private fun buildLanesForManeuver(maneuver: ManeuverType): List<com.xreal.hudnav.model.LaneItem> {
        return when (maneuver) {
            ManeuverType.TURN_RIGHT, ManeuverType.SLIGHT_RIGHT -> listOf(
                com.xreal.hudnav.model.LaneItem("STRAIGHT", false),
                com.xreal.hudnav.model.LaneItem("STRAIGHT", false),
                com.xreal.hudnav.model.LaneItem("STRAIGHT", false),
                com.xreal.hudnav.model.LaneItem("RIGHT", true)
            )
            ManeuverType.TURN_LEFT, ManeuverType.SLIGHT_LEFT -> listOf(
                com.xreal.hudnav.model.LaneItem("LEFT", true),
                com.xreal.hudnav.model.LaneItem("STRAIGHT", false),
                com.xreal.hudnav.model.LaneItem("STRAIGHT", false)
            )
            ManeuverType.U_TURN -> listOf(
                com.xreal.hudnav.model.LaneItem("UTURN", true),
                com.xreal.hudnav.model.LaneItem("STRAIGHT", false),
                com.xreal.hudnav.model.LaneItem("STRAIGHT", false)
            )
            else -> listOf(
                com.xreal.hudnav.model.LaneItem("STRAIGHT", true),
                com.xreal.hudnav.model.LaneItem("STRAIGHT", true),
                com.xreal.hudnav.model.LaneItem("RIGHT", false)
            )
        }
    }

    /**
     * 從 Notification 圖標提取像素重心以判定左轉/右轉
     */
    private fun analyzeNotificationIcon(notification: Notification): ManeuverType? {
        return try {
            val icon = notification.getLargeIcon() ?: return null
            val drawable = icon.loadDrawable(this) ?: return null
            val bitmap = if (drawable is BitmapDrawable) {
                drawable.bitmap
            } else {
                val bmp = Bitmap.createBitmap(32, 32, Bitmap.Config.ARGB_8888)
                val canvas = android.graphics.Canvas(bmp)
                drawable.setBounds(0, 0, 32, 32)
                drawable.draw(canvas)
                bmp
            }

            // 分析 32x32 左右兩半部的亮色像素密度
            val width = bitmap.width
            val height = bitmap.height
            var leftLum = 0L
            var rightLum = 0L

            for (y in 0 until height) {
                for (x in 0 until width) {
                    val pixel = bitmap.getPixel(x, y)
                    val alpha = (pixel shr 24) and 0xFF
                    val red = (pixel shr 16) and 0xFF
                    val green = (pixel shr 8) and 0xFF
                    val blue = pixel and 0xFF
                    val lum = (red + green + blue) * alpha / 255

                    if (x < width / 2) {
                        leftLum += lum
                    } else if (x > width / 2) {
                        rightLum += lum
                    }
                }
            }

            // 若右側像素明顯多於左側 (1.4 倍以上) 判定為右轉，反之為左轉
            when {
                rightLum > leftLum * 1.4 -> ManeuverType.TURN_RIGHT
                leftLum > rightLum * 1.4 -> ManeuverType.TURN_LEFT
                else -> null
            }
        } catch (e: Exception) {
            null
        }
    }

    private fun parseDistanceToMeters(distStr: String): Int {
        return try {
            val clean = distStr.lowercase().replace(" ", "")
            when {
                clean.contains("公里") || clean.contains("km") -> {
                    val num = clean.replace("公里", "").replace("km", "").toDouble()
                    (num * 1000).toInt()
                }
                clean.contains("公尺") || clean.contains("米") || clean.contains("m") -> {
                    clean.replace("公尺", "").replace("米", "").replace("m", "").toInt()
                }
                else -> 500
            }
        } catch (e: Exception) {
            500
        }
    }
}
