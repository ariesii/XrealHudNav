package com.xreal.hudnav.model

/**
 * 車道線單元資訊
 * @param iconType 車道方向指示（如 STRAIGHT, LEFT, RIGHT, STRAIGHT_RIGHT, UTURN 等）
 * @param isRecommended 是否為當前路口推薦行駛車道（高亮顯示）
 */
data class LaneItem(
    val iconType: String = "STRAIGHT",
    val isRecommended: Boolean = false
)

/**
 * 垂直路況光柱分段資訊
 * @param colorHex 路況顏色十六進制碼（綠 #34C759 順暢、黃 #FFCC00 緩行、紅 #FF3B30 擁堵）
 * @param weight 該路況段在總路程中的權重比例
 */
data class TrafficSegment(
    val colorHex: String = "#34C759",
    val weight: Float = 1.0f
)

/**
 * 紅綠燈號誌狀態
 */
enum class TrafficLightState(val label: String, val colorHex: String) {
    NONE("無號誌", "#000000"),
    RED("紅燈", "#FF3B30"),
    GREEN("綠燈", "#34C759"),
    YELLOW("黃燈", "#FFCC00")
}

/**
 * HUD 省電模型列舉
 */
enum class PowerMode(val label: String, val description: String) {
    NORMAL("標準模式", "完整 60fps 動態流光、GPS 高頻即時刷新"),
    ECO("智慧省電", "長途直行自動全黑休眠，路口自動喚醒節能"),
    ULTRA_ECO("極致續航", "純靜態超大字體，關閉所有動態，最長續航")
}

/**
 * 導航即時資訊資料結構
 */
data class NavInfo(
    val maneuver: ManeuverType = ManeuverType.STRAIGHT,
    val distance: String = "直行",
    val distanceMeters: Int = 1000,
    val roadNumber: String? = null,
    val roadName: String = "等待導航開始...",
    val nextAction: String? = null,
    val eta: String = "--:--",
    val remainingTime: String = "--",
    val remainingDistance: String = "--",
    val currentSpeed: Int = 0,
    val speedLimit: Int = 50,
    val cameraWarning: String? = null,
    val cameraDistance: Int? = null,
    val trafficLightState: TrafficLightState = TrafficLightState.NONE,
    val trafficLightSeconds: Int? = null,
    val batteryLevel: Int = 85,
    val isCharging: Boolean = false,
    val powerMode: PowerMode = PowerMode.NORMAL,
    val mapSource: String = "Google Maps",
    val isNavigating: Boolean = false,
    val lanes: List<LaneItem> = emptyList(),
    val trafficSegments: List<TrafficSegment> = emptyList(),
    val routeProgress: Float = 0.0f
) {
    fun isSpeeding(): Boolean = currentSpeed > speedLimit && speedLimit > 0
    fun hasTrafficLight(): Boolean = trafficLightState != TrafficLightState.NONE && trafficLightSeconds != null && trafficLightSeconds > 0
    fun hasLanes(): Boolean = lanes.isNotEmpty()
    fun hasTrafficSegments(): Boolean = trafficSegments.isNotEmpty()

    fun getFullRoadDisplay(): String {
        return if (!roadNumber.isNullOrBlank()) {
            "[$roadNumber] $roadName"
        } else {
            roadName
        }
    }
}
